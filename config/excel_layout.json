{
  "version": 1,
  "description": "Excel 怎么排版、数据写到哪里。后续可用自然语言要求 Codex 修改本文件。",
  "worksheetName": "汇总",
  "outputDirectory": "outputs",
  "titleTemplate": "竞品新品周报{start_m}.{start_d}-{end_m}.{end_d}",
  "introText": "以下是过去一周关注品牌的新品信息，如果有需要关注的单品，请告知，谢谢！",
  "trackedBrandsPrefix": "*关注品牌包括：",
  "summary": {
    "titleRow": 3,
    "introRow": 5,
    "headerRow": 6,
    "startRow": 7,
    "columns": {
      "brand": "B",
      "count": "C",
      "category": "D",
      "productName": "E",
      "launchDate": "F",
      "price": "G",
      "remark": "H"
    },
    "headers": {
      "count": "本周新品数量",
      "category": "品类",
      "productName": "新品名称",
      "launchDate": "上市时间",
      "price": "价格",
      "remark": "备注"
    }
  },
  "details": {
    "blankRowsAfterSummary": 1,
    "brandHeaderTemplate": "{brand}本周新品数量：{count}个",
    "labelColumn": "B",
    "valueRange": "C:H",
    "rowsPerProduct": [
      ["productName", "新品名称"],
      ["series", "产品系列归属"],
      ["sellingPoint", "产品卖点介绍"],
      ["price", "产品属性"],
      ["ingredients", "原料构成"],
      ["appearanceImages", "产品外观"]
    ]
  },
  "fonts": {
    "chineseExcelName": "方正FW筑紫黑简 R",
    "latinExcelName": "Heytea Sans Serif Regular",
    "defaultSize": 10,
    "titleSize": 16,
    "introSize": 12
  },
  "colors": {
    "white": "FFFFFF",
    "black": "000000",
    "headerFill": "DADADA",
    "brandFill": "FFFF00",
    "detailHeaderFill": "FEFF00",
    "detailLabelFill": "DAE3F4"
  },
  "columns": {
    "A": 6.0,
    "B": 11.6667,
    "C": 7.5,
    "D": 5.8333,
    "E": 12.5,
    "F": 8.1333,
    "G": 20.4083,
    "H": 15.8333
  },
  "rowHeights": {
    "topSpacer": 62.35,
    "title": 16.25,
    "intro": 17.6,
    "summaryHeader": 30.5,
    "summaryDefault": 16.25,
    "summaryWrapped": 30.5,
    "detailHeader": 16.25,
    "detailDefault": 16.25,
    "detailTextMin": 30.5,
    "detailTextMax": 72.0,
    "imageCm": 4.0
  },
  "image": {
    "heightCm": 4.0,
    "anchorColumn": "C",
    "maxWidthPx": 520
  },
  "notes": [
    "汇总表价格列换行只在 / 后插入换行。",
    "行高按内容估算到尽量显示完整内容，同时用 detailTextMax 防止长文本过高。",
    "产品外观图片高度固定为 4cm，等比缩放。"
  ]
}
